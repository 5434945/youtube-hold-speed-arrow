{
  "manifest_version": 3,
  "name": "YouTube Hold Speed Arrow",
  "version": "1.0.0",
  "description": "Hold a custom key to temporarily change YouTube playback speed without breaking arrow-key seeking.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "YouTube Hold Speed Arrow",
    "default_popup": "options.html"
  }
}
